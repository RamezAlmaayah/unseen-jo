# Browser-safe values from your verified project. Production defaults to Supabase.
# auto: Supabase when configured; development-only demo when both values are absent.
# Neither empty live results nor network errors ever trigger demo fallback.
VITE_DATA_MODE=supabase
# VITE_ values are public and bundled into browser code; RLS is mandatory.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never put service-role keys, secret keys, or database passwords in VITE_ variables.

# Optional public compatible style URL; default is the local reviewed style.
VITE_MAP_STYLE_URL=/maps/unseen-nature.json

# Local development only. Still requires a genuine Admin session and RLS.
# Ignored in every production build and on non-loopback hosts.
VITE_PRIVATE_PROTOTYPE=false

# Optional approved production HTTPS origin only, e.g. the real site root.
# Leave blank until the domain is approved. Never use localhost or the Supabase API URL.
# Rebuild after setting this to generate canonical, og:url and absolute social image URLs.
VITE_SITE_URL=
# Netlify Drop: use the actual assigned https://<site>.netlify.app origin once
# known, then rebuild locally. Drop uploads do not inject runtime variables.
# npm run build:netlify enforces live data, static legal content, disabled QA.

# Isolated UI fixtures only: ignored outside a loopback Vite development server.
# Production privacy controls stay unavailable regardless of this value.
VITE_PRIVACY_QA=false

# Keep static review pages until the legal migration and both approvals are ready.
# supabase: approved revisions only; unavailable documents pause application registration.
VITE_LEGAL_CONTENT_SOURCE=static
